# Un archivo de estos por CADA IDENTIDAD (no por maquina fisica). Si una
# maquina corre Claude Code Y Codex, son DOS identidades, DOS archivos,
# DOS apps de PM2 -- ver PROMPT_DEPLOY_DAEMON.md.
#
# Convencion de ubicacion (12/sep, cambio de systemd a PM2): va en
# /etc/mensajeria/identidades/<identidad>.env -- el ecosystem.config.js
# escanea ese directorio y crea un app de PM2 por archivo automaticamente.
# (ej. identidades/nodo-a-claude.env, identidades/nodo-a-codex.env,
# identidades/nodo-b-claude.env, identidades/nodo-b-codex.env)

MENSAJERIA_MAQUINA=nodo-a-claude
MENSAJERIA_AGENTE=claude
MENSAJERIA_BROKER_URL=http://broker.example.ts.net:8765
MENSAJERIA_API_KEY=CAMBIAR_ESTO_MISMA_KEY_QUE_EL_BROKER

# IMPORTANTE: rutas propias por identidad. Si dos identidades del mismo host
# comparten estos archivos, se pisan el rate limit y las capacidades entre si.
MENSAJERIA_CAPABILITIES_FILE=/etc/mensajeria/CAPABILITIES-nodo-a-claude.md
MENSAJERIA_RATE_LIMIT_FILE=/var/lib/mensajeria-daemon/nodo-a-claude/invocaciones.log

MENSAJERIA_WORKDIR=/home/mensajeria/workdir
MENSAJERIA_RATE_LIMIT_POR_HORA=10
MENSAJERIA_LIMITE_POR_PASADA=3
MENSAJERIA_CLAUDE_TIMEOUT_SEG=600
# Cada cuanto el daemon_loop.py hace una pasada nueva bajo PM2 (segundos).
MENSAJERIA_INTERVALO_SEG=300

# --- Solo si MENSAJERIA_AGENTE=claude ---
# Tools explicitamente permitidas/denegadas para el Claude Code headless.
# Ajustar por identidad segun lo que realmente necesite hacer -- arrancar
# restrictivo y sumar de a uno, no al reves.
MENSAJERIA_ALLOWED_TOOLS=Read,Grep,Glob,Bash(git status),Bash(git log*),Bash(git diff*)
MENSAJERIA_DISALLOWED_TOOLS=Bash(rm -rf*),Bash(git push*--force*),Bash(git push origin main),Bash(git push origin master),Bash(sudo*),Bash(shutdown*),Bash(reboot*)

# --- Solo si MENSAJERIA_AGENTE=codex ---
# Controla permisos via sandbox en vez de lista de tools. read-only es el
# default restrictivo -- subir a "workspace-write" solo si esa identidad
# puntual necesita escribir archivos, nunca por defecto.
MENSAJERIA_CODEX_SANDBOX=read-only

# --- Ejemplo de identidad OPENHANDS ---
# MENSAJERIA_MAQUINA=nodo-a-openhands
# MENSAJERIA_AGENTE=openhands
# OJO: el modo headless de OpenHands no tiene dial de permisos (siempre
# always-approve, ejecuta todo sin preguntar). El unico guardrail real es
# MENSAJERIA_WORKDIR bien acotado (su sandbox Docker propio) y que el
# coordinador solo le asigne tareas simples segun lo que declares en su
# CAPABILITIES.md.

# --- Ejemplo de identidad COORDINADOR (rol distinto, mismo daemon) ---
# MENSAJERIA_MAQUINA=coordinador-opus
# MENSAJERIA_AGENTE=claude
# MENSAJERIA_ROL=coordinador
# MENSAJERIA_CLAUDE_MODEL=claude-opus-5
# El coordinador no ejecuta tareas -- decide a quien asignarlas. Sus propios
# ALLOWED_TOOLS pueden quedar minimos (ni siquiera necesita Bash real, solo
# lee capacidades y redacta texto).
# MENSAJERIA_ALLOWED_TOOLS=Read
# MENSAJERIA_DISALLOWED_TOOLS=Bash(*)

