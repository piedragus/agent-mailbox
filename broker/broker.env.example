# Copiar a /etc/mensajeria/broker.env (chmod 600, dueno = usuario mensajeria)
# y completar con una API key real generada con: openssl rand -hex 32

MENSAJERIA_API_KEY=CAMBIAR_ESTO
MENSAJERIA_DB_PATH=/var/lib/mensajeria/mensajeria.db
MENSAJERIA_PORT=8765
MENSAJERIA_MAX_MSGS_POR_HILO=10

# Minutos en 'tomado' antes de devolver el mensaje a la cola (daemon muerto).
MENSAJERIA_TOMADO_TIMEOUT_MIN=30

# Default 127.0.0.1 -- ninguna otra maquina puede llegar. Para habilitar
# acceso desde otras identidades de la Tailnet (ej. nodo-b), poner la IP
# Tailscale de ESTA maquina (`tailscale ip -4`), NUNCA 0.0.0.0.
MENSAJERIA_BIND_HOST=127.0.0.1

# Alertas al remitente: minutos sin que nadie lea un mensaje antes de avisarle a quien lo mando.
MENSAJERIA_SIN_LEER_MIN=10
# Cada cuantos segundos el broker revisa alertas por su cuenta (0 = solo cuando alguien consulta).
MENSAJERIA_WATCHDOG_SEG=60
# Identidades humanas (separadas por coma): no reciben alertas automaticas por el broker.
MENSAJERIA_HUMANOS=humano

# --- Autenticacion por identidad (recomendado) ---
# Archivo JSON {"identidad": "clave"}; se administra con gestionar_claves.py. Cada clave identifica a UNA
# identidad: el broker fija `de` segun la clave y limita lo que puede leer/escribir.
MENSAJERIA_KEYS_FILE=/etc/mensajeria/keys.json
# 1 = la MENSAJERIA_API_KEY compartida sigue valiendo (migracion). Poner 0 cuando todos usen su clave.
MENSAJERIA_LEGACY_KEY=1
# Identidades con visibilidad total (ademas de los humanos): estado, hilos ajenos, esperando_humano.
MENSAJERIA_ADMINS=
# Tope de tamano del cuerpo y de mensajes por minuto por identidad.
MENSAJERIA_MAX_CUERPO=32768
MENSAJERIA_RATE_POST_MIN=60
